<?xml version="1.0" encoding="utf-8"?>
<!-- Big red rounded SOS button for the home-screen widget -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:type="linear" android:angle="270" android:startColor="#FF5A52" android:centerColor="#F2342C" android:endColor="#C8161D" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#73FFFFFF" />
        </shape>
    </item>
</layer-list>
